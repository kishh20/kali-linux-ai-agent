# Google Gemini API Key (Optional: system works offline with heuristics if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (gemini-2.5-flash or gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Default target IP for network reconnaissance and safe lab tools
DEFAULT_TARGET_IP=127.0.0.1

# Default network interface
DEFAULT_INTERFACE=lo
